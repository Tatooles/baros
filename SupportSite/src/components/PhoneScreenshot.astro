---
interface Props {
  src: string;
  alt: string;
  hero?: boolean;
  loading?: "eager" | "lazy";
}

const { src, alt, hero = false, loading = "lazy" } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-[42px] border border-ink bg-dark p-1.5 shadow-[0_30px_72px_rgba(9,18,29,0.24),0_6px_18px_rgba(9,18,29,0.16)] min-[561px]:rounded-[50px] min-[561px]:p-2",
    !hero && "w-full max-w-[20.75rem]",
    hero &&
      "w-[min(82vw,21.5rem)] rotate-0 min-[761px]:w-[17.875rem] min-[941px]:w-[20.625rem] min-[941px]:rotate-1",
  ]}
>
  <img
    class="w-full rounded-[36px] min-[561px]:rounded-[42px]"
    {src}
    width="1206"
    height="2622"
    {alt}
    {loading}
  />
</div>
